{
  "name": "portfolio-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo estático de projetos, formações e trajetória técnica de Deyverson Lima.",
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/check-links.mjs",
    "lint:js": "eslint .",
    "lint:html": "html-validate \"**/*.html\"",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run validate:data && npm run validate:links && npm run lint:js && npm run lint:html && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1"
  },
  "engines": {
    "node": ">=22"
  }
}
